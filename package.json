{
	"name": "inline-icons",
	"version": "0.0.0",
	"description": "Render icons inline in your notes with a short code span, using built-in icons or any icon registered by Custom Icons.",
	"main": "main.js",
	"scripts": {
		"dev": "node --env-file-if-exists=.env scripts/deploy.mjs link && node scripts/esbuild.config.mjs dev",
		"build": "tsc -noEmit -skipLibCheck && node scripts/esbuild.config.mjs prod && node --env-file-if-exists=.env scripts/deploy.mjs copy",
		"lint": "eslint src/ styles/",
		"i18n:typesafe": "typesafe-i18n",
		"i18n:sync": "node scripts/sync-i18n.mjs",
		"test": "jest",
		"test:watch": "jest --watch"
	},
	"keywords": [
		"Inline Icons",
		"Obsidian Plugin"
	],
	"author": "RavenHogWarts",
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=22.x"
	},
	"devDependencies": {
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^10.0.1",
		"@lezer/common": "^1.5.2",
		"@obsidian-typings/obsidian-catalyst-latest": "^6.23.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.3.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"esbuild": "0.28.2",
		"eslint": "^10.9.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"jest": "^30.4.2",
		"obsidian": "^1.13.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"release-please": "^17.11.2",
		"ts-jest": "^29.4.12",
		"tslib": "2.8.1",
		"typesafe-i18n": "^5.27.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0"
	}
}
